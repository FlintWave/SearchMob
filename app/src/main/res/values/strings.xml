    <string name="onboarding_welcome_title">Welcome to SearchMob</string>
    <string name="onboarding_welcome_body">Private, battery-friendly, on-device search. Let\'s set up a couple of things so SearchMob works well and you can search straight from your browser.</string>

    <string name="onboarding_permissions_title">Permissions</string>
    <string name="onboarding_permissions_body">SearchMob runs a small on-device service. These permissions keep it visible and alive — grant them when you\'re ready.</string>
