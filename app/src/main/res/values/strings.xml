    <string name="onboarding_default_search_body">Add SearchMob to your browser so address-bar searches go through your private server.</string>

    <string name="onboarding_privacy_title">Privacy</string>
    <string name="onboarding_privacy_body">SearchMob stores nothing by default. You can optionally enable encrypted, zero-knowledge search history in Settings.</string>
