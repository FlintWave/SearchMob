    <!-- Browser-setup guide -->
    <string name="setup_title">Browser setup</string>
    <string name="setup_intro">Add SearchMob as your browser\'s search engine so searches from the address bar go through your private, on-device server.</string>
    <string name="setup_visit_label">Page to visit</string>
    <string name="setup_template_label">Search template (for manual add)</string>
    <string name="setup_copy">Copy</string>
    <string name="setup_copied">Copied to clipboard</string>
    <string name="setup_open_browser">Open in browser</string>
    <string name="setup_not_running_title">Service not running</string>
    <string name="setup_not_running_body">The on-device search server isn\'t running, so there\'s no address to add yet. Start the service, then come back here.</string>
    <string name="setup_start_service">Start service</string>

    <string name="setup_chrome_title">Chrome</string>
    <string name="setup_chrome_step1">Open the page above in Chrome at least once so it\'s discoverable.</string>
    <string name="setup_chrome_step2">Go to Settings → Search engine → Manage search engines &amp; site search.</string>
    <string name="setup_chrome_step3">Under \"Site search\", find SearchMob (or tap Add and paste the search template), then set it as default.</string>

    <string name="setup_firefox_title">Firefox</string>
    <string name="setup_firefox_step1">Open the page above in Firefox.</string>
    <string name="setup_firefox_step2">Tap the menu → Settings → Search.</string>
    <string name="setup_firefox_step3">Add a search engine using the search template, then set SearchMob as the default.</string>

    <string name="setup_manual_title">Other browsers (manual)</string>
    <string name="setup_manual_step1">In your browser\'s search-engine settings, add a custom engine.</string>
    <string name="setup_manual_step2">Paste the search template as the query URL — keep the %s placeholder intact.</string>
    <string name="setup_manual_step3">Set the new engine as your default.</string>

